{
  "name": "halil-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "stats": "node scripts/fetch-stats.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify-build.mjs",
    "linkcheck": "linkinator dist --recurse --silent --skip https://",
    "og": "pnpm add -D satori @resvg/resvg-js @fontsource/jetbrains-mono tsx && tsx scripts/og.ts && pnpm remove satori @resvg/resvg-js @fontsource/jetbrains-mono tsx",
    "check:browser": "node scripts/browser-audit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
