---
import { SECTION_IDS, type SectionId } from '../../data/types';

interface Props {
  id: SectionId;
  heading: string;
  intro?: string;
}

const { id, heading, intro } = Astro.props;
const headingId = `${id}-heading`;

/*
 * Görünen "01/02…" numarası SECTION_IDS sırasından TÜRETİLİR.
 * Daha önce çağıran taraf elle index={1..7} geçiyordu; SideRail ise aynı
 * numaraları SECTION_IDS'ten üretiyordu. İki ayrı doğruluk kaynağı vardı ve
 * bir bölüm yeniden sıralandığında sessizce ayrışabilirlerdi.
 */
const index = SECTION_IDS.indexOf(id) + 1;
---

<section id={id} aria-labelledby={headingId} class="scroll-mt-28 py-14 sm:py-20">
  <div class="mb-6 flex items-baseline gap-3 border-b border-[var(--color-line)] pb-3" data-reveal>
    <span class="section-index shrink-0" aria-hidden="true">
      {String(index).padStart(2, '0')}
    </span>
    <h2 id={headingId} class="text-xl sm:text-2xl">
      {heading}
    </h2>
  </div>

  {intro && (
    <p class="text-muted mb-8 max-w-[62ch] text-[15px]" data-reveal>
      {intro}
    </p>
  )}

  <slot />
</section>
