---
import type { SiteContent } from '../../data';
import { SECTION_IDS } from '../../data/types';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

{/* Masaüstü yan navigasyonu — mobilde TopBar'daki chip satırı devralır. */}
<nav aria-label={content.ui.sectionsLabel} class="sticky top-28 hidden self-start lg:block">
  <ol class="space-y-1">
    {SECTION_IDS.map((id, index) => (
      <li>
        <a
          href={`#${id}`}
          data-nav-link={id}
          class="nav-rail text-muted group flex items-center gap-3 rounded-[3px] py-1.5 pr-2 pl-3 font-mono text-[13px] transition-colors"
        >
          <span class="nav-rail-tick" aria-hidden="true" />
          <span class="text-faint w-5 shrink-0 text-[11px] tabular-nums">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="truncate">{content.nav[id]}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
