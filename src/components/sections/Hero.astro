---
import type { Locale } from '../../data/types';
import type { SiteContent } from '../../data';
import { hasCv, site } from '../../data/site';
import { experience } from '../../data/timeline';
import { assetHref, formatMonth } from '../../i18n/utils';
import ExternalLink from '../ui/ExternalLink.astro';

interface Props {
  content: SiteContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const { hero, ui, education } = content;

/* "Şu an" kartındaki şirket ve başlangıç tarihi tek kaynaktan türer. */
const current = experience.find((entry) => entry.end === null);
const currentRole = current ? content.experience.items[current.id].role : hero.role;

/* Sertifikalar zaten "hazırlık aşamasında"; kartta yalnızca kısa adları. */
const preparing = education.certifications.map((certification) => certification.name).join(' · ');

const now: { label: string; value: string }[] = [
  { label: hero.roleLabel, value: currentRole },
  ...(current
    ? [
        {
          label: hero.companyLabel,
          value: `${current.org} · ${formatMonth(current.start, locale)} –`,
        },
      ]
    : []),
  { label: hero.locationLabel, value: hero.location },
  /* DİL satırı bilerek YOK: Hakkımda bölümünde daha ayrıntılı hâli var
     ("Türkçe — ana dil" / "İngilizce — CEFR B1–B2") ve ikisi geniş ekranda
     aynı anda görünüyordu. */
  { label: hero.prepLabel, value: preparing },
];
---

<section id="top" class="scroll-mt-28 pt-10 pb-10 sm:pt-14 sm:pb-14">
  {/*
    Geniş ekranda iki sütun: metin solda, "Şu an" kartı sağda. Tek sütunken
    sağ yarı boş kalıyor, alttaki Yetenekler ise tam genişlik olduğu için
    bölümler arası grid tutarsız görünüyordu.
  */}
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start lg:gap-14">
    <div>
      <p class="text-accent-fg mb-4 font-mono text-xs tracking-[0.16em] uppercase" data-reveal>
        {hero.role}
      </p>

      <h1
        class="mb-6 text-[clamp(2rem,7vw,3.25rem)] leading-[1.08] font-bold tracking-tight"
        data-reveal
        data-reveal-delay="1"
      >
        {hero.name}
      </h1>

      <p
        class="text-muted mb-8 max-w-[62ch] text-[15px] leading-relaxed sm:text-base"
        data-reveal
        data-reveal-delay="2"
      >
        {hero.positioning}
      </p>

      <div class="flex flex-wrap gap-3" data-reveal data-reveal-delay="3">
        {
          /* İş arayan bir sitede birincil eylem CV indirmek; GitHub ikincil.
             Dosya public/cv/ altında yoksa buton hiç render edilmez. */
          hasCv && (
            <a href={assetHref(site.cvPath)} class="btn btn-primary" download>
              <svg
                class="h-4 w-4"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M8 1.5v9M4.5 7.5 8 11l3.5-3.5M2.5 13.5h11" />
              </svg>
              {hero.ctaCv}
            </a>
          )
        }

        <ExternalLink href={site.github.url} class="btn" newTabLabel={ui.externalLink}>
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
          {hero.ctaGithub}
        </ExternalLink>

        <ExternalLink href={site.linkedin.url} class="btn" newTabLabel={ui.externalLink}>
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M3.6 14H1V5.3h2.6V14ZM2.3 4.2A1.5 1.5 0 1 1 2.3 1.2a1.5 1.5 0 0 1 0 3ZM15 14h-2.6V9.8c0-1-.02-2.3-1.4-2.3-1.4 0-1.6 1.1-1.6 2.2V14H6.8V5.3h2.5v1.2h.04c.35-.66 1.2-1.36 2.48-1.36 2.65 0 3.14 1.74 3.14 4V14Z"></path>
          </svg>
          {hero.ctaLinkedin}
        </ExternalLink>
      </div>
    </div>

    <aside
      class="card p-5 lg:sticky lg:top-28"
      aria-labelledby="now-heading"
      data-reveal
      data-reveal-delay="2"
    >
      <h2
        id="now-heading"
        class="text-accent-fg mb-4 border-b border-[var(--color-line)] pb-2 font-mono text-[11px] tracking-[0.14em] uppercase"
      >
        {hero.nowHeading}
      </h2>

      <dl class="space-y-3">
        {now.map((row) => (
          <div>
            <dt class="text-faint font-mono text-[10px] tracking-[0.14em] uppercase">
              {row.label}
            </dt>
            <dd class="text-text mt-0.5 font-mono text-[13px] leading-snug">{row.value}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>
